# AI Therapist Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# AI MODEL API KEYS
# =============================================================================
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="AI Therapist API"
ENVIRONMENT=development
DEBUG=true
APP_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30
ENABLE_RLS=true
VECTOR_DIMENSION=768
SIMILARITY_THRESHOLD=0.7

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE=30
REFRESH_TOKEN_EXPIRE=7
PASSWORD_RESET_EXPIRE=15

# Security Features
ENABLE_INPUT_MODERATION=true
ENABLE_OUTPUT_MODERATION=true
ENABLE_PII_DETECTION=true
ENABLE_CRISIS_DETECTION=true
ENABLE_CRISIS_ESCALATION=false

# Rate Limiting
RATE_LIMIT_WS=60
RATE_LIMIT_API=100

# Content Filtering Thresholds
PII_THRESHOLD=0.8
CRISIS_THRESHOLD=0.7

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
MODEL_CHAT=gemini/gemini-2.0-flash
MODEL_LIGHT=gemini/gemini-2.0-flash-lite
MODEL_EMBEDDING=text-embedding-ada-002

# Temperature Settings
TEMP_CHAT=0.2
TEMP_CLASSIFIERS=0.0

# Token Limits
MAX_TOKENS_CHAT=1000
MAX_TOKENS_SUMMARY=500

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
STRUCTURED_LOGGING=true
LOG_INCLUDE_TRACE=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_WEBSOCKET=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# =============================================================================
# DEVELOPMENT SETTINGS (for development environment only)
# =============================================================================
# Uncomment these for development
# DEBUG=true
# RELOAD=true
# LOG_LEVEL=DEBUG

# =============================================================================
# PRODUCTION SETTINGS (for production environment only)
# =============================================================================
# Uncomment and configure these for production
# ENVIRONMENT=production
# DEBUG=false
# RELOAD=false
# LOG_LEVEL=INFO
# ENABLE_CRISIS_ESCALATION=true
